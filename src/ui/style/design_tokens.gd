class_name UiTokens
extends RefCounted
## 시각 언어의 **단일 출처**. 색·간격·글자 크기·시간·형태 치수가 전부 여기서만 나온다.
##
## 값을 씬이나 위젯에 직접 적으면 같은 뜻의 숫자가 여러 곳에 흩어진다.
## 그러면 "이 회색과 저 회색이 같은 회색인가"를 아무도 대답할 수 없게 되고,
## 그 상태가 곧 화면이 브랜드를 잃는 지점이다.
##
## 왜 이런 색인가 · 왜 이런 형태인가는 docs/design/18-visual-identity.md 에 있다.
## 요약하면 두 겹이다.
##
##   계측 레이어 — 시설이 만든 정보. 인광 청록. 정확하지만 모호하다
##   송출 레이어 — 렉카가 만든 정보. 방송 주홍. 구체적이지만 못 믿는다
##
## 이 둘을 절대 섞지 않는 것이 이 게임 화면의 규칙이다.

# ---------------------------------------------------------------------------
# 색 — 다섯 역할
# ---------------------------------------------------------------------------

## 시설 바탕. 순수 회색이 아니라 녹색이 아주 살짝 섞인 저채도다.
## 형광등이 켜진 콘크리트 세트의 색이고, 인광 청록과 같은 계열에 있어 화면이 한 덩어리로 보인다.
const VOID := Color(0.027, 0.039, 0.035)
const FLOOR := Color(0.047, 0.063, 0.059)
const PLATE := Color(0.090, 0.116, 0.108)
const PLATE_HIGH := Color(0.129, 0.163, 0.152)
const SEAM := Color(0.180, 0.226, 0.212)

## 계측 레이어 — **사실**. 위험도 숫자, 고도, 눈금, 살아 있는 연결.
## 인광(phosphor) 청록은 계측기가 스스로 빛을 내는 색이다. 누가 꾸민 색이 아니다.
const SIGNAL := Color(0.310, 0.863, 0.659)
const SIGNAL_HOT := Color(0.604, 1.000, 0.816)
const SIGNAL_DIM := Color(0.173, 0.471, 0.376)
const SIGNAL_GHOST := Color(0.090, 0.220, 0.180)

## 송출 레이어 — **과장**. 렉카 자막, 송출 표시, 화제성.
## 방송 주홍은 ON AIR 등과 속보 자막의 색이다. 정보가 아니라 시선을 끄는 장치다.
const ONAIR := Color(0.961, 0.220, 0.290)
const ONAIR_DIM := Color(0.486, 0.129, 0.188)

## 시설 안전 표지 — **물리적 금지**. 오직 "길은 있으나 못 오른다"에만 쓴다.
## 위협의 색이 아니다. 위협은 사실이므로 계측 색으로 적힌다.
const HAZARD := Color(0.886, 0.651, 0.173)
const HAZARD_DIM := Color(0.416, 0.310, 0.086)

## 글자. 순백을 쓰지 않는다. 순백은 인광보다 밝아져 위계를 뒤집는다.
const INK := Color(0.824, 0.863, 0.843)
const INK_MUTED := Color(0.518, 0.588, 0.561)
const INK_FAINT := Color(0.306, 0.361, 0.341)

# ---------------------------------------------------------------------------
# 글자 크기 — 폰트가 하나뿐이라 크기와 색만이 위계를 만든다
# ---------------------------------------------------------------------------

## SongMyung 하나로 버텨야 하므로 굵기 대비를 쓸 수 없다.
## 대신 **단계를 크게 벌린다.** 11 - 13 - 15 - 19 - 27 - 38 은 인접 단계 비가 1.2~1.4 로,
## 나란히 놓았을 때 "조금 큰 글자"가 아니라 다른 종류의 글자로 읽힌다.
const TYPE_MICRO := 11
const TYPE_LABEL := 13
const TYPE_BODY := 15
const TYPE_TITLE := 19
const TYPE_NUMBER := 27
const TYPE_DISPLAY := 38

# ---------------------------------------------------------------------------
# 간격 — 두 단계만 쓴다
# ---------------------------------------------------------------------------

## **관련 있는 것은 붙이고, 다른 것은 크게 벌린다.**
## 모든 간격을 같게 두면 화면이 균일해지고, 균일한 화면에는 위계가 없다.
## 실제로 쓰는 것은 대부분 TIGHT 와 GAP 둘뿐이고 나머지는 여백·정렬용이다.
const SPACE_TIGHT := 4
const SPACE_SNUG := 8
const SPACE_STEP := 14
const SPACE_GAP := 24
const SPACE_RIFT := 40

# ---------------------------------------------------------------------------
# 형태 — 둥근 모서리를 쓰지 않는다
# ---------------------------------------------------------------------------

## 잘린 모서리(챔퍼)의 크기. 역할마다 **자르는 모서리와 크기가 다르다.**
## 같은 반지름으로 네 귀퉁이를 굴리는 순간 모든 요소가 서로 구별되지 않는다.
const CUT_TILE := 16.0
const CUT_PANEL := 20.0
const CUT_CHIP := 10.0
const CUT_BUTTON := 9.0

## 선 굵기. 세 단계뿐이다.
const STROKE_HAIR := 1.0
const STROKE_RULE := 2.0
const STROKE_BEAM := 3.0

## 코너 브래킷(카메라 프레임)의 팔 길이.
const BRACKET_ARM := 13.0

## 통로 점선의 길이와 사이. 통로는 중계 구역이 아니라서 이어진 선으로 그리지 않는다.
const DASH_LENGTH := 9.0
const DASH_GAP := 7.0

# ---------------------------------------------------------------------------
# 시간 — 움직이는 것은 변한 것이다
# ---------------------------------------------------------------------------

## 값이 바뀐 순간의 섬광. 눈에 띄되 읽기를 방해하지 않는 길이다.
const TIME_FLASH := 0.09

## 상태가 바뀌어 자리를 잡는 시간.
const TIME_SETTLE := 0.22

## 변화량 표시가 떠올랐다 사라지기까지. 한 번 읽을 시간은 줘야 한다
## (docs/design/13-information-design.md §13.7 — 이전 값을 기억하도록 UI 가 돕는다).
const TIME_GHOST := 1.5

## 송출 표시의 맥동 주기. 심장박동보다 느려야 초조해지지 않는다.
const TIME_PULSE := 1.9

## 배경 간섭선이 화면을 한 번 훑는 시간.
const TIME_DRIFT := 6.5

# ---------------------------------------------------------------------------
# 파생값
# ---------------------------------------------------------------------------


## 알파만 바꾼 같은 색. 색을 새로 정의하지 않고 투명도를 조절할 때 쓴다.
static func fade(color: Color, alpha: float) -> Color:
	return Color(color.r, color.g, color.b, alpha)


## 방 하나의 위젯 크기.
##
## 카메라 조작(끌기·확대 범위)이 이 값에서 나오므로 함부로 바꾸지 않는다.
## docs/design/07-level-design.md §7.8 의 배율 동작을 재조정해야 한다.
static func tile_size() -> Vector2:
	return Vector2(146.0, 76.0)


## 방 타일이 잘리는 모서리. **좌상단 하나만** 자른다.
##
## 네 귀퉁이를 다 자르면 팔각형이 되어 다시 "둥근 모서리"와 같은 인상이 된다.
## 하나만 자르면 방향이 생기고, 그 자리가 신호가 들어오는 곳이 된다.
static func tile_cuts() -> PackedFloat32Array:
	return PackedFloat32Array([CUT_TILE, 0.0, 0.0, 0.0])


## 계측 패널이 잘리는 모서리. 우하단 하나.
## 타일과 반대쪽을 자르는 이유는 둘이 같은 화면에서 구별되어야 하기 때문이다.
static func panel_cuts() -> PackedFloat32Array:
	return PackedFloat32Array([0.0, 0.0, CUT_PANEL, 0.0])


## 송출 자막 조각이 잘리는 모서리. 우상단과 좌하단 — 기울어 보인다.
## 계측 레이어는 반듯하고 송출 레이어는 기운다.
static func chip_cuts() -> PackedFloat32Array:
	return PackedFloat32Array([0.0, CUT_CHIP, 0.0, CUT_CHIP])
