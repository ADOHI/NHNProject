class_name KitTokens
extends RefCounted
## 이 UI 키트의 **조형 상수**. 이야기가 아니라 치수와 색이다.
##
## 키트 전체가 하나의 규칙 위에 서 있다.
## **화면에는 칠해진 면이 없다. 등고선(isoline)만 있다.**
## 요소는 그려지는 물건이 아니라 화면 전체에 깔린 고도장(場)을 밀어 올린 자리이고,
## 테두리는 그은 것이 아니라 비탈에 등고선이 몰려서 생긴 것이다.
##
## 그래서 여기 있는 수는 두 종류뿐이다 — **길이(px)와 고도(단)**.
## 색은 고도의 함수이므로 색 상수도 고도 구간으로 나뉜다.

## 길이의 원자. 모든 치수·여백은 이 값의 정수배다.
##
## 배경 등고선의 평균 간격(약 16px)의 절반으로 잡았다. 요소의 크기와 사이가
## 화면에 이미 그려져 있는 줄로 셀 수 있어야 규격이 "보인다".
const UNIT := 8.0

## 고도 한 단. 등고선 한 줄이 아니라 **요소 한 급(級)** 이다.
const STEP := 1.0

## 버튼의 급. 고도가 크기를 정한다 — 높은 것이 큰 것이다.
## 임의로 정한 세 개의 크기가 아니라, 고도 1·2·3 단에서 유도된 세 개다.
const ELEVATION_SUB := 1.0
const ELEVATION_MAIN := 2.0
const ELEVATION_KEY := 3.0

## 팝업의 고도. 버튼 최고급의 두 배 위. 같은 화면에서 다툴 수 없는 높이다.
const ELEVATION_POPUP := 6.0

## 고도에서 높이를 얻는다. 32 + 8·h → 40 / 48 / 56.
const HEIGHT_BASE := 32.0

## 비탈의 폭(px). 등고선 고리가 요소 **바깥**에 깔리는 거리다.
##
## 비탈을 안쪽이 아니라 바깥에 두는 이유가 있다. 안쪽은 평평해야(등고선이 없어야)
## 글자가 읽히고, 바깥에 비탈이 있어야 **옆 요소의 비탈과 만난다.**
## 그래서 간격이 지형의 형태로 드러난다 — 붙으면 능선, 멀면 각자의 봉우리.
const SKIRT_BUTTON := 30.0
const SKIRT_POPUP := 120.0

## 간격의 세 급. 비탈 폭(30)을 기준으로 정해진다 — 두 비탈이 만나는 거리가 60px 다.
## 붙음(16): 비탈이 깊이 겹쳐 두 요소가 하나의 능선이 된다. 이음매는 등고선 한 칸도 안 되게 얕다.
## 묶임(32): 비탈이 절반쯤 겹쳐 사이에 안장(saddle)이 생긴다.
## 분리(64): 비탈이 거의 닿지 않아 각자 닫힌 고리를 갖는다.
const GAP_JOINED := UNIT * 2.0
const GAP_GROUPED := UNIT * 4.0
const GAP_APART := UNIT * 8.0

## 모서리 반지름. 요소의 최상단 등고선이 곧 윤곽선이므로,
## 이 값은 "지형의 봉우리 평면이 얼마나 둥근가" 이다.
const CORNER := 3.0

## 등고선 한 줄 사이의 고도 차. 작을수록 줄이 촘촘하다.
##
## 버튼(2단)의 비탈에 여섯 줄이 깔리도록 잡았다. 비탈이 가장자리에서 가장 가파르므로
## 그 여섯 줄은 1.4 / 3.5 / 6.9 / 13.3 / 30px 로 **벌어지며** 놓인다 — 등간격이 아니다.
## 호버로 고도가 오르면 줄 수가 늘어 **봉우리에서 새 고리가 밀려 나온다.**
const CONTOUR_STEP := 0.34

## 등고선의 반폭(px).
const LINE_HALF_WIDTH := 0.62

## 굵기의 위계. 다섯 줄마다 하나를 이 배수로 굵게 긋는다(지형도의 계곡선).
##
## 굵기가 하나뿐이면 화면 전체가 같은 무게로 깔려 경사를 읽을 수 없고,
## 그때 등고선은 지형이 아니라 벽지 무늬가 된다.
const INDEX_EVERY := 5.0
const INDEX_WEIGHT := 2.6

## 팝업이 주변 지반을 눌러 만드는 웅덩이의 깊이(단).
## 화면을 어둡게 덮는 대신 **주변 땅을 꺼뜨려** 뒤가 물러나게 한다.
const MOAT_DEPTH := 2.6

## 색. 고도의 함수다.
## 꺼진 땅은 차갑고(청회색), 지반은 중간, 솟은 땅은 따뜻하고 밝다(뼈색).
const GROUND := Color(0.039, 0.043, 0.051)
const LINE_LOW := Color(0.239, 0.310, 0.384)
const LINE_MID := Color(0.400, 0.384, 0.345)
const LINE_HIGH := Color(0.902, 0.871, 0.788)

## 강세색. 화면에서 채도를 가진 유일한 색이고 **선에만** 쓴다.
const ACCENT := Color(1.0, 0.294, 0.149)

## 글자색. 봉우리 평면 위에 얹히므로 등고선 최고 밝기와 같은 계열이다.
const TEXT := Color(0.886, 0.867, 0.804)
const TEXT_DIM := Color(0.478, 0.459, 0.416)

## 글자 크기의 세 급. 고도 급과 짝을 이룬다.
const FONT_SUB := 15
const FONT_MAIN := 17
const FONT_KEY := 19
const FONT_TITLE := 24

## 상태가 고도를 바꾸는 양.
##
## 호버는 솟는다. 포커스도 조금 솟되 그 몫은 작다 — 포커스의 본체는 높이가 아니라
## 쉬지 않고 도는 물결이므로, 높이까지 크게 주면 호버와 구별되지 않는다.
## 눌림은 0 아래로 내려가 **구덩이**가 된다.
## 비활성은 3분의 2쯤 주저앉되 **없어지지는 않는다.** 지면까지 낮추었더니
## 등고선이 근처를 지나가지 않아 결국 흐린 글자만 남았다 — 그건 opacity 0.35 다.
## 낮은 봉우리로 남기고 **정상을 다듬지 않아**(셰이더의 clear) 바탕의 결이
## 글자 위를 그대로 지나가게 한다. 손대다 만 자리로 읽힌다.
const GAIN_HOVER := 0.5
const GAIN_FOCUS := 0.22
const SINK_PRESS := 1.35
const FLATTEN_DIM := 0.35

## 상태가 붙고 떨어지는 시간(초). 붙는 것이 떨어지는 것보다 빠르다.
const TIME_HOVER_IN := 0.10
const TIME_HOVER_OUT := 0.22
const TIME_PRESS_IN := 0.045
const TIME_PRESS_OUT := 0.16
const TIME_FOCUS := 0.18

## 가만히 있을 때의 숨. 고도가 오르내린다.
##
## 주기를 2.4초로 잡았다. 4초로 두었더니 어느 1초를 잘라 봐도 한 방향으로만
## 움직여, 부풀었다 꺼지는 왕복이 화면에 나타나지 않았다.
## 진폭은 등고선 한 칸(0.34단)보다 크게 잡았다. 그보다 작으면 줄이 한 개도 넘나들지 않아
## 화면상 아무 일도 일어나지 않는다. 요소마다 위상을 어긋내므로 이웃한 둘의
## 바깥 고리가 붙었다 떨어지고, 그 **연결이 바뀌는 순간**이 이 키트의 idle 이다.
const BREATH_AMPLITUDE := 0.30
const BREATH_RATE := 2.6


## 고도에서 높이를 얻는다. 32 + 8·h → 40 / 48 / 56.
static func height_for(elevation: float) -> float:
	return HEIGHT_BASE + UNIT * elevation


## 글자 크기도 고도가 정한다. 크기 체계가 둘로 갈라지지 않게 한 값에서 유도한다.
static func font_size_for(elevation: float) -> int:
	if elevation >= ELEVATION_KEY:
		return FONT_KEY
	if elevation >= ELEVATION_MAIN:
		return FONT_MAIN
	return FONT_SUB
