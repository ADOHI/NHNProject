## 미리 구워 둔 것이 있으면 그 경로. 없으면 빈 문자열.
static func path_for(request: SfxRequest, variation: int) -> String:
	var key := "%s#%d" % [request.bake_key(), variation]
	if not KEYS.has(key):
		return ""
	return "%s/baked_%03d.wav" % [DIR, KEYS[key]]


static func size() -> int:
	return KEYS.size()
