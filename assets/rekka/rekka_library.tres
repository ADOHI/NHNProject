[gd_resource type="Resource" script_class="RekkaLibrary" format=3]

[ext_resource type="Script" path="res://src/core/rekka/rekka_library.gd" id="1_tiypb"]

[resource]
script = ExtResource("1_tiypb")
keys = PackedStringArray("QUIET", "QUIET", "QUIET", "MOVED:", "MOVED:", "MOVED:", "MOVED:", "SEARCHED:빈손", "SEARCHED:빈손", "SEARCHED:푼돈", "SEARCHED:푼돈", "SEARCHED:한몫", "SEARCHED:한몫", "SEARCHED:대박", "SEARCHED:대박", "ACQUIRED:빈손", "ACQUIRED:푼돈", "ACQUIRED:푼돈", "ACQUIRED:한몫", "ACQUIRED:한몫", "ACQUIRED:대박", "ACQUIRED:대박", "ENCOUNTERED:", "ENCOUNTERED:맞대면", "ENCOUNTERED:맞대면", "ENCOUNTERED:한줌", "ENCOUNTERED:떼거리", "FOUGHT:", "FOUGHT:맞대면", "FOUGHT:맞대면", "FOUGHT:한줌", "FOUGHT:한줌", "FOUGHT:떼거리", "NEGOTIATED:빈손", "NEGOTIATED:푼돈", "NEGOTIATED:한몫", "NEGOTIATED:한몫", "NEGOTIATED:대박", "FLED:", "FLED:맞대면", "FLED:맞대면", "FLED:한줌", "FLED:떼거리", "DOWNED:", "DOWNED:맞대면", "DOWNED:맞대면", "DOWNED:한줌", "DOWNED:떼거리", "ESCAPED:빈손", "ESCAPED:빈손", "ESCAPED:푼돈", "ESCAPED:한몫", "ESCAPED:대박", "ESCAPED:대박")
posts = PackedStringArray("아무도 안 움직이는 중인데 이게 더 무섭다\n다들 서로 눈치만 보고 있는 각인데\n[가] 조용한 게 제일 비싼 신호임\n[나] 지금 안 들어가면 언제 들어가냐\n[다] 나는 이런 턴에 사고 나는 거 여러 번 봤다", "소식 없음\n[가] 렉카 일 안 하냐\n[나] 밑에서 뭔가 하고 있는 거 맞음\n[다] 진짜 아무 일도 없었으면 그것도 뉴스지", "잠잠하다는 건 누가 숨 고르는 중이라는 뜻이다\n이런 턴 뒤에 꼭 뭐가 터지더라\n[가] 다음 편 각 잡고 기다린다\n[나] 지루하다고 채널 돌리면 손해임", "{주체} 자리 옮겼다\n동선 보면 뭘 노리는지 대충 나온다\n[가] {방} 쪽으로 왜 감?\n[나] 저기 이미 누가 훑고 갔을 텐데\n[다] 나는 저 각 절대 안 잡음", "{주체이} 슬금슬금 움직이는 중\n[가] 저거 도망가는 동선인데\n[나] 아니 계산하고 가는 거임. 봐라\n[다] 둘 다 맞을 수 있음", "{방} 쪽으로 붙는 놈 나왔다\n[가] 저기 뭐 있길래\n[나] 없으니까 가는 거지\n[다] 있으면 벌써 소문 났음", "발자국 소리만 나는 중\n아무도 안 멈추는 턴이 제일 재미없다\n[가] 뭐라도 좀 해라\n[나] 준비 중인 거임\n[다] 준비만 하다 판 끝나는 거 여러 번 봤다", "{방} 털어봐야 아무것도 없다는 게 증명됨\n빈손도 정보다. 저기 이미 누가 지나갔다는 뜻이니까\n[가] {주체} 표정 궁금하다\n[나] 헛걸음한 게 제일 아프지\n[다] 아니 저기가 왜 비어 있냐고", "헛수고 생중계\n[가] 저기 원래 그런 방임\n[나] 남이 먼저 갔다는 소리지\n[다] 다음 방은 남아 있길 빈다", "{방} 결과 푼돈. 이걸 뒤지러 갔냐\n[가] 푼돈도 돈이다\n[나] 저거 챙기는 시간에 다른 데 갔으면\n[다] 나는 저런 거 줍는 사람 좋아함", "{주체이} 긁은 값 나왔는데 푼돈이다\n기대치 관리 실패한 표정 보인다\n[가] 손익 계산 들어간다\n[나] 그래도 빈손보단 낫지", "{방} 한몫 나왔다\n저기 아직 남았을 수도 있으니 참고해라\n[가] 지금 뛰면 늦지 않았나\n[나] 이미 늦음\n[다] {방} 위치 아는 사람", "오늘 벌이는 나왔다는 표정\n[가] 딱 저 정도가 제일 애매함\n[나] 더 욕심내다 다 놓치는 거 여러 번 봄\n[다] 나는 저기서 바로 나온다", "{방}에서 대박 터졌다\n이거 소문 나면 저 방 앞에 줄 선다\n[가] 판 뒤집혔네\n[나] {주체} 오늘 운 다 썼다\n[다] 지금 저기로 몰리는 거 보인다\n[라] 나만 늦게 알았냐", "대박이랍니다\n남의 대박은 왜 이렇게 재밌지\n[가] 실화면 오늘 판 끝\n[나] 저 방 이름 적어둔다", "{주체이} 손에 쥔 게 없다\n[가] 이걸 챙겼다고 해야 하나\n[나] 기록에는 남겠지", "{주체} 푼돈 챙김\n[가] 그래도 안 죽고 챙긴 게 어디냐\n[나] 저거 팔면 밥값은 나옴\n[다] 밥값 나오면 성공 아님?", "푼돈 들고 나오는 중\n욕심 안 부린 건지 부릴 게 없었던 건지\n[가] 후자에 건다\n[나] 나는 전자라고 봄", "{주체} 한몫 챙겼다\n가방 무거워지면 발이 느려진다. 그게 이 판 규칙이지\n[가] 지금이 제일 위험한 순간임\n[나] 나가는 길이 제일 길다\n[다] 누가 저거 노리고 있을 텐데", "{방}에서 한몫 나왔다는 얘기\n[가] 확인된 거 맞냐\n[나] 렉카가 지어낼 이유가 없지\n[다] 있지. 조회수", "{주체} 대박 챙겼다. 이제 표적이다\n많이 챙길수록 유명해지고 유명해질수록 위험해진다\n[가] 이거 나가는 길에 다 뺏길 각\n[나] 나 같으면 지금 바로 나감\n[다] 못 나감. 저 각에서 못 나가는 거 여러 번 봤음\n[라] 구경값 제대로 하네", "대박이다\n[가] 축하한다 진심으로\n[나] 진심 아닌 거 다 안다\n[다] 응", "{방}에서 마주쳤다는데 뒤가 없다\n[가] 그래서 어떻게 됐냐고\n[나] 저건 그냥 지나간 거임\n[다] 지나간 게 더 무섭다", "{방} 지금 분위기 이상함\n서로 아무것도 안 하고 지나가는 게 제일 이상한 거다\n[가] 둘이 아는 사이 아니냐\n[나] 나는 짜고 치는 거라고 봄\n[다] 그냥 둘 다 손해 볼 각이라 뺀 거지", "{주체와} {상대} 마주침\n[가] 여기서 안 붙는 게 더 신기함\n[나] 다음 턴 각 잡고 있는 거임\n[다] 나는 벌써 팝콘 챙김", "{방}에 여럿 몰렸다\n좁은 데 여럿 모이면 답 나온다\n[가] 저기 지금 못 들어감\n[나] 저기 들어가는 놈이 이기는 거임", "{방} 지금 발 디딜 데가 없다\n[가] 이건 못 낀다\n[나] 낄 생각을 왜 함\n[다] 저 안에서 뭐가 나올지 궁금하긴 하다", "{방}에서 손 나갔다\n[가] 결과가 없는데 이게 기사냐\n[나] 결과 나오면 그때 또 올려주겠지", "{방} 붙었다\n말로 안 되면 이렇게 되는 거지\n[가] {주체} 이길 것 같음\n[나] 저기서 이겨봤자 남는 게 없음\n[다] 남는 게 없는 싸움이 제일 재밌음", "결국 붙었네\n[가] 누가 먼저 손 댔냐\n[나] 그게 중요하냐\n[다] 나중에 판 정리할 때 중요해짐", "{방}에서 여럿 엉켰다\n이 정도면 혼자 끼어들 각은 아니다\n[가] 지금 저기 지나가면 안 됨\n[나] 돌아가는 길 있나\n[다] 없으니까 저기 붙은 거지", "{주체} 결국 발 담갔다\n[가] 안 담글 수가 없는 자리였음\n[나] 담근 순간 진 거임\n[다] 그건 결과 나와봐야 알지", "{방} 지금 난장판이다\n이 규모면 누가 이기든 성한 사람이 없다\n[가] 이건 구경만 한다\n[나] 나 저기 근처에 아는 사람 있는데\n[다] 명복은 이르다. 아직 안 끝났음", "거래는 했는데 오간 게 없다\n[가] 그럼 그냥 대화 아니냐\n[나] 대화도 거래지", "{주체} 푼돈짜리 거래 텄다\n싼 거래일수록 뒤가 구리다\n[가] 통행세 낸 거 아님?\n[나] 저 정도면 그냥 인사값이지\n[다] 인사값 받고 길 터준 거면 그게 통행세임", "{방}에서 한몫짜리가 오갔다\n이런 건 나중에 꼭 말이 나온다\n[가] 누가 손해 본 건지 계산 중\n[나] 둘 다 이득이면 그게 제일 무서운 거임\n[다] 셋째가 손해 본 거지", "{주체와} {상대} 손잡았다\n[가] 저 조합은 예상 못 했다\n[나] 이 판에서 오래 못 감\n[다] 오래 갈 필요 없지. 이 판만 넘기면 됨", "대박짜리 거래가 성사됐다\n이 판의 무게중심이 여기서 한 번 움직였다\n[가] 이거 판이 통째로 넘어간 거 아니냐\n[나] 넘어갔지\n[다] 남은 사람들 어떡하냐\n[라] 알아서 하겠지", "{주체} 발 뺐다\n[가] 잘한 판단임\n[나] 저래놓고 나중에 후회함", "{주체} 튐\n도망도 판단이다. 다만 그 다음이 없으면 그냥 밀린 거지\n[가] 저건 도망이 아니라 후퇴임\n[나] 같은 말 아니냐\n[다] 다르지. 돌아올 거면 후퇴", "{방}에서 빠져나가는 중\n[가] 지금 쫓아가면 잡을 각\n[나] 쫓아가는 놈이 더 위험함", "{주체이} 여럿 피해서 뺐다\n[가] 이건 잘 뺀 거임\n[나] 저 상황에서 안 빼면 답 없지", "{주체} 그냥 도망쳤다\n저 규모 보고 안 도망치면 그게 이상한 거지\n[가] 이건 뭐 선택의 여지가 없었음\n[나] 애초에 왜 들어갔냐가 문제지", "{주체} 뻗었다\n[가] 끝난 건 아니지?\n[나] 아직 확정된 거 하나도 없다", "{방} 하나 정리됐다\n쓰러졌다고 끝난 건 아니다. 그건 확정하지 말자\n[가] 지금 저 방 비었다는 소리네\n[나] 비긴 뭐가 비어. 누워 있는 사람이 있는데\n[다] 그래서 비었다는 거임", "{주체} 주저앉았다\n[가] 저 자리 지금 지나가는 사람 조심해라\n[나] 조심할 게 아니라 기회지\n[다] 그렇게 생각하다 같이 눕는 거임", "{방}에서 여럿 주저앉았다\n[가] 저기 지금 무슨 일이 난 거냐\n[나] 순서대로 밀린 거지\n[다] 밀린 게 아니라 몰린 거임", "{방} 지금 서 있는 사람이 몇 없다\n이 정도 규모가 한 번에 정리되는 건 흔한 그림이 아니다\n[가] 저기 뭐가 있는 거냐\n[나] 있으니까 저렇게 됐겠지\n[다] 나는 저 방 이름 기억해둔다", "{주체} 빈손으로 나갔다\n살아 나간 것도 성적이긴 하다\n[가] 이게 제일 아픈 결말임\n[나] 아프긴 해도 다음 판이 있지\n[다] 다음 판에 또 빈손이면?", "빈손 퇴장\n[가] 들어간 값도 못 뽑았네\n[나] 목숨값은 뽑았지", "{주체} 푼돈 들고 나갔다\n[가] 딱 본전 각\n[나] 본전이면 잘한 거임\n[다] 이 판에서 본전은 실패임", "{주체} 한몫 들고 빠졌다\n챙기고 나가는 것까지가 실력이다\n[가] 나갈 때를 아는 게 제일 어려움\n[나] 저 타이밍은 인정한다\n[다] 더 있었으면 더 벌었을 텐데", "{주체} 대박 들고 나갔다\n이 판은 여기서 끝이다. 남은 사람들만 억울하게 됐다\n[가] 저게 진짜 나간 거 맞냐\n[나] 나갔다니까\n[다] 인정할 건 인정하자\n[라] 나는 인정 못 함", "{방} 통해서 대박이 통째로 빠져나갔다\n[가] 저 문 왜 안 막았냐\n[나] 막을 수 있었으면 막았지\n[다] 다음 판에는 저기부터 잡는다")
