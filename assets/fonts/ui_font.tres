[gd_resource type="SystemFont" format=3]

; 임시 조치. 시스템에 설치된 한글 폰트를 빌려 쓴다.
;
; Godot 기본 폰트에는 한글 글리프가 없어 그대로 두면 UI 가 전부 두부(□)로 나온다.
; 다만 SystemFont 는 **웹 빌드에서 동작하지 않는다** — 브라우저에는 빌려 올 시스템 폰트가 없다.
; 제출 전에 재배포 가능한 한글 폰트를 서브셋해 임베드해야 한다.
; 근거와 용량 예산은 docs/design/09-art-sound.md §9.3 참고.

[resource]
font_names = PackedStringArray("Malgun Gothic", "맑은 고딕", "Noto Sans KR", "NanumGothic", "Segoe UI")
