# Godot 텍스트 리소스는 항상 LF 로 통일 (Windows 로컬 ↔ Linux CI 간 diff 오염 방지)
* text=auto eol=lf

*.gd    text eol=lf
*.tscn  text eol=lf
*.tres  text eol=lf
*.godot text eol=lf
*.cfg   text eol=lf

# 바이너리로 취급해야 하는 에셋
*.png   binary
*.jpg   binary
*.webp  binary
*.ogg   binary
*.wav   binary
*.mp3   binary
*.ttf   binary
*.otf   binary
